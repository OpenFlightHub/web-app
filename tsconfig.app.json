{
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "definitions/**/*","src/layouts/**/*.vue"],
  "exclude": ["src/**/__tests__/*"],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "$/*": ["./*"]
    },
    "skipLibCheck": true,
    "target": "es2020",
    "resolveJsonModule": true,
    "module": "es2020",
    "moduleResolution": "bundler"
  }
}
