{
  "files": [],
  "references": [
    {
      "path": "./tsconfig.config.json"
    },
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.vitest.json"
    }
  ],
  "compilerOptions": {
    "target": "es2020",
    "lib": ["es2020"],
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    /* TODO if possible enable "strict": true,*/
